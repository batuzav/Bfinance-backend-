# Local-only values for the e2e suite and the smoke scripts. Committed on purpose: nothing here is a
# real secret (the database is the throwaway docker container on port 5433). Origin: blueprint §19.6.
PORT=3100
NODE_ENV=test
DATABASE_URL=postgres://libromayor:libromayor@localhost:5433/libromayor_test
DATABASE_URL_DIRECT=postgres://libromayor:libromayor@localhost:5433/libromayor_test
JWT_SECRET=test-only-secret-not-for-production-0000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REGISTRATION_ENABLED=true
CORS_ORIGINS=https://allowed.example
SWAGGER_ENABLED=false
GIT_SHA=test
THROTTLE_DISABLED=true
